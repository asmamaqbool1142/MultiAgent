# Copy this file to .env. Keep real credentials out of source control.
GROQ_API_KEY=docker compose up

GROQ_MODEL=openai/gpt-oss-120b
# Legacy provider settings; the app currently uses Groq.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
XAI_API_KEY=
XAI_MODEL=
APP_TIMEZONE=Asia/Karachi
# Create a Google OAuth Web application and use this exact local callback URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8001/auth/google/callback

# Accounts. Optional: only these emails/@domains may sign up (empty = anyone).
ALLOWED_EMAILS=
# Google sign-in reuses GOOGLE_CLIENT_ID/SECRET. Register BOTH redirect URIs in
# Google Cloud: <host>/auth/google/callback and <host>/auth/sso/google/callback
